{
  "display_information": {
    "display_name": "Scalable RTMS Backend",
    "description": "Route Zoom Meeting RTMS traffic to isolated, scalable media workers.",
    "long_description": "A user-managed Zoom app that sends Meeting RTMS lifecycle events to a scalable backend, routes each stream to one worker, and processes live media with customer-managed infrastructure."
  },
  "oauth_information": {
    "usage": "USER_OPERATION",
    "development_redirect_uri": "https://your-development-domain.example.com/oauth/callback",
    "production_redirect_uri": "https://your-production-domain.example.com/oauth/callback",
    "oauth_allow_list": [
      "https://your-development-domain.example.com",
      "https://your-production-domain.example.com"
    ],
    "strict_mode": true,
    "subdomain_strict_mode": false,
    "scopes": [
      {
        "scope": "meeting:read:meeting_audio",
        "optional": false
      },
      {
        "scope": "meeting:read:meeting_video",
        "optional": false
      },
      {
        "scope": "meeting:read:meeting_transcript",
        "optional": false
      },
      {
        "scope": "meeting:read:meeting_screenshare",
        "optional": false
      },
      {
        "scope": "meeting:read:meeting_chat",
        "optional": false
      }
    ],
    "scope_description": "Receive the Zoom Meeting media types selected by the scalable RTMS worker configuration."
  },
  "features": {
    "products": [
      "ZOOM_MEETING"
    ],
    "event_subscription": {
      "enable": true,
      "events": [
        {
          "subscription_name": "Meeting RTMS Lifecycle Events",
          "event_types": [
            "meeting.rtms_started",
            "meeting.rtms_stopped",
            "meeting.rtms_interrupted",
            "rtms.concurrency_limited"
          ],
          "development_webhook_url": "https://your-development-domain.example.com/webhook",
          "production_webhook_url": "https://your-production-domain.example.com/webhook"
        }
      ]
    }
  }
}
