{
  "name": "meeting-transcript-quickstart",
  "description": "Capture live Zoom Meeting transcripts and save VTT, SRT, and text files.",
  "scopes": [
    "meeting:read:meeting_transcript"
  ],
  "redirect_url": "https://YOUR_DOMAIN.example.com/auth/callback",
  "event_subscriptions": [
    {
      "endpoint_url": "https://YOUR_DOMAIN.example.com/webhook",
      "events": [
        "meeting.rtms_started",
        "meeting.rtms_stopped"
      ]
    }
  ]
}
