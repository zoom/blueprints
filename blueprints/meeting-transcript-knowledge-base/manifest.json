{
  "display_information": {
    "display_name": "Meeting Transcript Knowledge Base",
    "description": "Capture live Zoom Meeting transcripts and save VTT, SRT, text, and JSONL files.",
    "long_description": "A user-managed Zoom app that receives live transcript data through RTMS and stores each meeting stream in common caption, text, and event-log formats."
  },
  "oauth_information": {
    "usage": "USER_OPERATION",
    "development_redirect_uri": "https://example.ngrok.app/oauth/callback",
    "production_redirect_uri": "https://blueprint.example.ngrok.app/oauth/callback",
    "oauth_allow_list": [
      "https://example.ngrok.app",
      "https://blueprint.example.ngrok.app"
    ],
    "strict_mode": true,
    "subdomain_strict_mode": false,
    "scopes": [
      {
        "scope": "meeting:read:meeting_transcript",
        "optional": false
      }
    ],
    "scope_description": "Receive live Zoom Meeting transcript data through RTMS."
  },
  "features": {
    "products": [
      "ZOOM_MEETING"
    ],
    "event_subscription": {
      "enable": true,
      "events": [
        {
          "subscription_name": "Meeting RTMS Events",
          "event_types": [
            "meeting.rtms_started",
            "meeting.rtms_stopped"
          ],
          "development_webhook_url": "https://example.ngrok.app/webhook",
          "production_webhook_url": "https://blueprint.example.ngrok.app/webhook"
        }
      ]
    }
  }
}
