{
  "display_information": {
    "display_name": "Sales Coach",
    "description": "Real-time sales coaching powered by RTMS transcription",
    "long_description": "A real-time sales coaching application that streams live transcripts from Zoom meetings, analyzes conversations for qualification signals (BANT), detects competitor mentions, and displays coaching cues in an in-meeting panel visible only to the seller."
  },
  "oauth_information": {
    "usage": "USER_OPERATION",
    "development_redirect_uri": "https://YOUR-NGROK-URL/api/auth/callback",
    "production_redirect_uri": "https://YOUR-PRODUCTION-URL/api/auth/callback",
    "oauth_allow_list": [
      "https://YOUR-NGROK-URL"
    ],
    "scopes": [
      {
        "scope": "zoomapp:inmeeting",
        "optional": false
      },
      {
        "scope": "meeting:read:meeting",
        "optional": false
      },
      {
        "scope": "user:read",
        "optional": true
      }
    ],
    "scope_description": "Meeting access for live transcription via RTMS and user profile for personalization."
  },
  "features": {
    "products": ["ZOOM_MEETING"],
    "development_home_uri": "https://YOUR-NGROK-URL",
    "production_home_uri": "https://YOUR-PRODUCTION-URL",
    "domain_allow_list": [
      {
        "domain": "YOUR-NGROK-URL",
        "explanation": "Development server"
      },
      {
        "domain": "appssdk.zoom.us",
        "explanation": "Required for Zoom Apps SDK"
      }
    ],
    "in_client_feature": {
      "zoom_app_api": {
        "enable": true,
        "zoom_app_apis": [
          "getMeetingContext",
          "getMeetingUUID",
          "getRunningContext",
          "getUserContext",
          "getMeetingParticipants",
          "authorize",
          "onAuthorized",
          "promptAuthorize",
          "showNotification",
          "onRunningContextChange"
        ]
      },
      "guest_mode": {
        "enable": false
      },
      "in_client_oauth": {
        "enable": true
      }
    },
    "zoom_client_support": {
      "mobile": {
        "enable": false
      },
      "zoom_room": {
        "enable": false
      },
      "pwa_client": {
        "enable": false
      }
    },
    "event_subscription": {
      "enable": true,
      "events": [
        {
          "subscription_name": "RTMS Events",
          "event_types": [
            "meeting.rtms_started",
            "meeting.rtms_stopped"
          ],
          "development_webhook_url": "https://YOUR-NGROK-URL/api/rtms/webhook",
          "production_webhook_url": "https://YOUR-PRODUCTION-URL/api/rtms/webhook"
        }
      ]
    }
  }
}
